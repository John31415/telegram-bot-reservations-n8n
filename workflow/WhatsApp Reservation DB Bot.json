    {
      "parameters": {
        "jsCode": "// Agrupa todas las filas recibidas de Postgres en un solo texto Markdown\nlet schemaText = \"# ESQUEMA DE LA BASE DE DATOS POSTGRESQL\\n\\n\";\n\nfor (const item of $input.all()) {\n  const tableName = item.json.table_name;\n  const columns = item.json.columns;\n  \n  schemaText += `## Tabla: ${tableName}\\n`;\n  schemaText += `Columnas:\\n`;\n  \n  for (const col of columns) {\n    const nullable = col.is_nullable === 'YES' ? 'NULL' : 'NOT NULL';\n    schemaText += `  - ${col.column_name} (${col.data_type}, ${nullable})\\n`;\n  }\n  schemaText += `\\n`;\n}\n\nreturn [{\n  json: {\n    db_schema_prompt: schemaText\n  }\n}];"
      },
